# Frontend (Vite) — optional overrides for Firebase web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend (Flask / Vercel)
# Comma-separated admin emails (also accepts Firebase custom claim admin=true)
ADMIN_EMAILS=you@example.com

# Firebase Admin (required in production / Vercel)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Force auth to fail closed even outside Vercel
# AUTH_FAIL_CLOSED=true
# AUTH_REQUIRED=true

# ── ChurnSight service ──────────────────────────────────────────────
# Database: SQLite under .data/ by default. Use Postgres for anything shared:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/churnsight
# DATA_DIR=/data                  # model artifacts + scored snapshots
# WORKSPACE_MODE=user             # user (default) | domain | shared
# MAX_UPLOAD_MB=25
# MAX_ROWS=500000
# SYNC_JOBS=0                     # 1 = run training inline (automatic on Vercel)
# RATE_LIMIT_PER_MIN=240
# HEAVY_RATE_LIMIT_PER_MIN=12
# CORS_ORIGINS=https://app.example.com
# METRICS_TOKEN=change-me         # enables GET /metrics (send as 'Authorization: Bearer <token>')
# EMBEDDED_WORKER=1               # 0 = web only enqueues; run `python -m churn.worker` separately
# JOB_TIMEOUT_S=3600  JOB_MAX_ATTEMPTS=3  JOB_STALE_S=45
# REDIS_URL=redis://localhost:6379/0   # shared rate limiting across web processes
# STORAGE_BACKEND=local           # local | s3 (needs boto3; S3_BUCKET, S3_PREFIX, S3_ENDPOINT_URL)
# PLAN_LIMITS_JSON='{"trial": {"seats": 5}, "team": {"training_runs": 100}}'   # override plan limits (defaults in api/churn/quotas.py are placeholders)
# APP_URL=https://churn.example.com      # link included in alert messages
# SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_FROM=alerts@example.com   # enables email channels
# INGEST_RATE_LIMIT_PER_MIN=120  MAX_INGEST_ROWS=5000  MAX_TABLE_ROWS=5000000
# SAFEHTTP_ALLOW_LOCAL=1                 # DEVELOPMENT/TESTS ONLY: lets webhooks and connectors call localhost/http. Never set in production.
# SENTRY_DSN=                     # optional error reporting (request data is stripped)

# ── Security (see docs/THREAT_MODEL.md) ─────────────────────────────
# REQUIRED in production: the master key that wraps every workspace's data key. 32 random bytes, base64:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# CHURN_MASTER_KEY=
# KEY_PROVIDER=local              # local | aws-kms (needs boto3 + AWS credentials; KMS_KEY_ID)
# KMS_KEY_ID=
# ENCRYPT_FIELDS=1                # encrypt per-customer attributes/explanations at rest (default: on in production)
# REQUIRE_MFA_ROLES=admin,owner   # roles that must sign in with a second factor (default in production)
# AUTO_PROVISION=0                # 1 lets any new account create its own workspace (default: on in development only)
# TEST_DATABASE_URL=postgresql+psycopg://churn_app:churn_app@localhost:5432/churn   # run the test suite on Postgres (RLS tests)
